with(LinearAlgebra);
dh:=Transpose(<<1,1,1,1,1,1>|<0,0,0,1,1,1>|<2*d,0,0,0,d,1>|<0,d,1,2*d,0,0>>);
dnspace := NullSpace(dh);


RowMul := proc(A, row1, row2, x)
  description "adds x times row1 from row2";
  M:=Matrix(RowDimension(A));
  for i from 1 to RowDimension(M)
    do M[i,i]:=1;
  end do;
  M[row2, row1] := x;
  Multiply(M, A);
end proc;

ColMul := proc(A, col1, col2, x)
  description "adds x times col1 to col2";
  M:=Matrix(RowDimension(A));
  for i from 1 to RowDimension(M)
    do M[i,i]:=1;
  end do;
  M[col1, col2] := x;
  Multiply(A, M);
end proc;

ColSwap := proc(A, row1, row2)
  description "swaps row1 and row2";
  M:=Matrix(RowDimension(A));
  for i from 1 to RowDimension(M)
    do M[i,i]:=1;
  end do;
  M[row1, row1] := 0;
  M[row2, row2] := 0;
  M[row1, row2] := 1;
  M[row2, row1] := 1;
  Multiply(A, M);
end proc;

RowSwap := proc(A, row1, row2)
  description "swaps row1 and row2";
  M:=Matrix(RowDimension(A));
  for i from 1 to RowDimension(M)
    do M[i,i]:=1;
  end do;
  M[row1, row1] := 0;
  M[row2, row2] := 0;
  M[row1, row2] := 1;
  M[row2, row1] := 1;
  Multiply(M, A);
end proc;

