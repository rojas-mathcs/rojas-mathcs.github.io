Digits:=40; 

c:=exp(1)/(exp(1)-1) ; 

addd:=(d,p,s)-> if s=0 then 1 # monos have at most one affine root 
        elif s=1 then 1+ d*p*(p^d-1)/(p-1) # binoms have at most 1+B(L,2,1) roots...
        elif s=2 then 1+d*p*(p^d-1)*(1+4*c*(p^d-1)*(1+d*log(2*d/log(p))/log(p)))/(p-1) # really 1+B(L,2,1)+B(L,2,1)B(L,3,1) 
        else 1+d*p*(p^d-1)*(1+4*c*(p^d-1)*(1+d*log(2*d/log(p))/log(p)))/(p-1) + sum((p^d-1)^k *floor(k*6^(k-1)*c^k*(1+d*log(d/log(p))/log(p)) *(1+d*log(2*d/log(p))/log(p))^(k-1) * (k!)),k=3..s); 
        end if: 

ad:=(d,p,s)-> addd(d,p,s) : 

addd2:=s-> if s=0 then 1 # monos have at most one affine root 
        elif s=1 then 1+ 2 # binoms have at most 1+B(L,2,1) roots...
        elif s=2 then 1+2*(1+6) # really 1+B(L,2,1)+B(L,2,1)B(L,3,1) 
        else 15 + sum(3^(k-1) * floor(k*2^(k-1)*c^k*(1-log(log(2))/log(2)) *(2-log(log(2))/log(2))^(k-1) * (k!)),k=3..s); 
        end if: 

ad2:=s-> addd2(s) : 

